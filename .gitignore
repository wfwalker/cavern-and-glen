# ─── DEPENDENCIES ───
# Never commit node_modules; it's massive and generated automatically via npm install
node_modules/

# don't commit Bill's not-in-use folder
not-in-use/

# ─── BUILD OUTPUTS ───
# This is the compiled production code generated by 'npm run build'
dist/
src/**/*.js

# ─── OS JUNK ───
# System files generated by Mac/Windows that don't belong in code repos
.DS_Store
Thumbs.db

# ─── LOGS AND CACHES ───
npm-debug.log*
.vite/
.eslintcache